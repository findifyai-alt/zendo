      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique meeting identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "description": "Business ID owning this meeting.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientId": {
          "type": "string",
          "description": "Client identifier for this meeting.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "proposalId": {
          "type": "string",
          "description": "Optional linked proposal identifier.",
          "minLength": 0,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Meeting subject.",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "description": "Meeting type description.",
          "minLength": 1,
          "maxLength": 80
        },
        "date": {
          "type": "string",
          "description": "Scheduled meeting date.",
          "minLength": 1,
          "maxLength": 40
        },
        "time": {
          "type": "string",
          "description": "Scheduled meeting time.",
          "minLength": 1,
          "maxLength": 40
        },
        "durationMinutes": {
          "type": "number",
          "description": "Meeting duration in minutes.",
          "minimum": 5,
          "maximum": 480
