          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when meeting was scheduled."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when meeting was updated."
        }
      },
      "required": [
        "id",
        "businessId",
        "clientId",
        "title",
        "date",
        "time",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Project": {
