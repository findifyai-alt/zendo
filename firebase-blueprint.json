        },
        "clientId": {
          "type": "string",
          "description": "Optional linked client ID.",
          "minLength": 0,
          "maxLength": 128
        },
        "proposalId": {
          "type": "string",
          "description": "Optional linked proposal ID.",
          "minLength": 0,
          "maxLength": 128
        },
        "meetingId": {
          "type": "string",
          "description": "Optional linked meeting ID.",
          "minLength": 0,
          "maxLength": 128
        },
        "projectId": {
          "type": "string",
          "description": "Optional linked project ID.",
