  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profiles containing business ID and settings."
    },
    "/clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/Client"
      },
      "description": "Client directory documents isolated by businessId."
    },
    "/proposals/{proposalId}": {
      "schema": {
        "$ref": "#/entities/Proposal"
      },
      "description": "Client proposals isolated by businessId with clientId reference."
    },
    "/meetings/{meetingId}": {
      "schema": {
        "$ref": "#/entities/Meeting"
      },
      "description": "Scheduled meetings isolated by businessId with clientId reference."
    },
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Projects isolated by businessId with clientId reference."
    },
    "/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/Task"
      },
      "description": "Workflow tasks isolated by businessId with optional relational references."
    },
    "/followUps/{followUpId}": {
      "schema": {
        "$ref": "#/entities/FollowUp"
      },
      "description": "Client follow-ups isolated by businessId with clientId and proposalId references."
    },
    "/payments/{paymentId}": {
      "schema": {
        "$ref": "#/entities/Payment"
      },
      "description": "Invoices and payments isolated by businessId with clientId reference."
    }
  }
}
