{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user workspace profile containing business ID, display settings, and plan tier.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the workspace owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "description": "Unique business identifier for tenant data isolation.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name shown in the Zendo workspace.",
          "minLength": 1,
          "maxLength": 80
        },
        "workspaceName": {
          "type": "string",
          "description": "Name of the user's Zendo workspace.",
          "minLength": 1,
          "maxLength": 80
        },
        "activePlan": {
          "type": "string",
          "description": "Current Zendo subscription tier.",
          "enum": ["Free", "Pro", "Team"],
          "minLength": 3,
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "uid",
        "businessId",
        "displayName",
        "workspaceName",
        "activePlan",
        "createdAt",
        "updatedAt"
      ]
    },
    "Client": {
      "title": "Client",
      "description": "Client account record belonging to a business.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique client document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "description": "Business ID owning this client.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Contact person name.",
          "minLength": 1,
          "maxLength": 80
        },
        "company": {
          "type": "string",
          "description": "Company name.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "description": "Contact email address.",
          "minLength": 3,
          "maxLength": 120
        },
        "industry": {
          "type": "string",
          "description": "Industry classification.",
          "minLength": 1,
          "maxLength": 80
        },
        "totalProposals": {
          "type": "number",
          "description": "Number of proposals created for this client.",
          "minimum": 0
        },
        "pipelineValue": {
          "type": "string",
          "description": "Formatted pipeline value string.",
          "minLength": 1,
          "maxLength": 40
        },
        "lastActivity": {
          "type": "string",
          "description": "Summary of recent client interaction.",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "description": "Client status.",
          "enum": ["Active", "Prospect", "Won"],
          "minLength": 3,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when client was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when client was last updated."
        }
      },
      "required": [
        "id",
        "businessId",
        "name",
        "company",
        "email",
        "industry",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Proposal": {
      "title": "Proposal",
      "description": "Client proposal document belonging to a business and linked to a client.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique proposal document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "description": "Business ID owning this proposal.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientId": {
          "type": "string",
          "description": "Referenced client document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Proposal title.",
          "minLength": 1,
          "maxLength": 200
        },
        "clientCompany": {
          "type": "string",
          "description": "Target client company.",
          "minLength": 1,
          "maxLength": 120
        },
        "clientName": {
          "type": "string",
          "description": "Target contact person name.",
          "minLength": 1,
          "maxLength": 80
        },
        "clientEmail": {
          "type": "string",
          "description": "Contact email address.",
          "minLength": 0,
          "maxLength": 120
        },
        "industry": {
          "type": "string",
          "description": "Client industry.",
          "minLength": 0,
          "maxLength": 80
        },
        "value": {
          "type": "string",
          "description": "Formatted proposal value string.",
          "minLength": 1,
          "maxLength": 40
        },
        "numericValue": {
          "type": "number",
          "description": "Numeric proposal value in USD.",
          "minimum": 0,
          "maximum": 10000000
        },
        "status": {
          "type": "string",
          "description": "Proposal status.",
          "enum": ["Draft", "Sent", "Viewed", "Follow-up", "Accepted", "Declined"],
          "minLength": 4,
          "maxLength": 20
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when proposal was last updated."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when proposal was created."
        }
      },
      "required": [
        "id",
        "businessId",
        "clientId",
        "title",
        "value",
        "numericValue",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Meeting": {
      "title": "Meeting",
